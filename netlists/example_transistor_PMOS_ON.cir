* PMOS_ON: single PMOS (every terminal on its own voltage source)
.include 45nm_LP.pm
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.param Lmin=4.5e-08
M1 d g s b pmos W=2.259466e-07 L={Lmin}
Vd d 0 0.3400856893
Vg g 0 0
Vs s 0 0.6831360191
Vb b 0 0.9625366465
.control
set numdgt=15
altermod @pmos[vth0] = -0.5643920065
altermod @pmos[toxe] = 1.687074728e-09
altermod @pmos[ndep] = 2.633235377e+18
altermod @pmos[u0] = 0.02181619839
altermod @pmos[xj] = 1.287648646e-08
set temp = -11.3156
op
print i(vd) i(vg) i(vs) i(vb)
.endc
.end
