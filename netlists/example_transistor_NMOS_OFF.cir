* NMOS_OFF: single NMOS (every terminal on its own voltage source)
.include 45nm_LP.pm
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.param Lmin=4.5e-08
M1 d g s b nmos W=1.637559e-07 L={Lmin}
Vd d 0 0.1541226025
Vg g 0 0
Vs s 0 0.4556790359
Vb b 0 0
.control
set numdgt=15
altermod @nmos[vth0] = 0.6382358865
altermod @nmos[toxe] = 1.791182196e-09
altermod @nmos[ndep] = 3.453272739e+18
altermod @nmos[u0] = 0.0454095206
altermod @nmos[xj] = 1.467689958e-08
set temp = 118.921
op
print i(vd) i(vg) i(vs) i(vb)
.endc
.end
